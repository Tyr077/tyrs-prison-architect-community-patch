<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>PAPatcher</AssemblyName>
    <RootNamespace>PAPatcher</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Prison Architect Community Patch</Product>
    <AssemblyTitle>Prison Architect Community Patch</AssemblyTitle>
    <Description>Applies community bug-fix patches to a locally installed Prison Architect executable.</Description>
    <Deterministic>true</Deterministic>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Every *.patch.json in ../patches is embedded and shows up as a fix in the UI. -->
    <EmbeddedResource Include="..\patches\*.patch.json" LogicalName="%(Filename)%(Extension)" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

</Project>
